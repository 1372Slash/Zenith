<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Never back up or transfer the usage database. It contains per-app usage
      history and intercepted notification content. Only preferences and
      lightweight app state are included, for both cloud backup and
      device-to-device transfers.
    -->
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb"/>
        <include domain="file" path="datastore/runtime_state.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb"/>
        <include domain="file" path="datastore/runtime_state.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
