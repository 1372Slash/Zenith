<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Usage history, hourly buckets, website usage, and intercepted notification
      content live in zenith_database. No database domain is included here, so
      Android Auto Backup and device transfers only carry preferences and
      lightweight app state.
    -->
    <include domain="file" path="datastore/settings.preferences_pb"/>
    <include domain="file" path="datastore/runtime_state.preferences_pb"/>
</full-backup-content>
